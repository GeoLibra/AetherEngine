{
  "name": "@aether/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./shader-tooling": "./src/shader-tooling.ts"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "vite build",
    "prebuild": "pnpm run shader:check",
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "shader:generate": "vite-node --script scripts/cook-built-in-shaders.ts",
    "shader:check": "vite-node --script scripts/cook-built-in-shaders.ts --check",
    "shader:wgsl:cook": "vite-node --script scripts/cook-wgsl-shader.ts",
    "shader:bundle:check": "vite-node --script scripts/check-runtime-shader-bundle.ts",
    "shader:native:test": "cargo +1.95.0 test --manifest-path tools/naga-shader-validator/Cargo.toml",
    "bench": "vite-node benchmark/framework/cli.ts",
    "bench:validate": "pnpm bench validate",
    "bench:changed": "pnpm bench changed",
    "bench:all": "pnpm bench all",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "node scripts/check-staged-format.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test",
    "e2e:project": "playwright test --project",
    "e2e:resolve": "vite-node --script e2e/cli.ts",
    "example:dev": "pnpm --dir examples/react-vite-ts dev",
    "example:build": "pnpm --dir examples/react-vite-ts build",
    "example:typecheck": "pnpm --dir examples/react-vite-ts typecheck",
    "verify:commit": "pnpm run typecheck && pnpm test && pnpm run build && pnpm bench validate && pnpm bench changed"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "bitecs": "0.4.0",
    "koota": "0.6.6",
    "prettier": "^3.6.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.11",
    "vite-node": "^2.1.4",
    "vitest": "^2.1.4"
  }
}
